{
  "manifest_version": 3,
  "name": "Góndola para Coto: diseño claro, precio por kilo, nutrición y comparador",
  "short_name": "Góndola",
  "version": "0.14.1",
  "description": "Mejora Coto Digital: diseño más claro, precio real por kilo o litro, tu banco, otros súper, información nutricional y alergias.",
  "icons": {
    "16": "assets/icon/icon-16.png",
    "32": "assets/icon/icon-32.png",
    "48": "assets/icon/icon-48.png",
    "128": "assets/icon/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.carrefour.com.ar/*",
    "https://diaonline.supermercadosdia.com.ar/*",
    "https://www.masonline.com.ar/*",
    "https://world.openfoodfacts.org/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_title": "Góndola",
    "default_icon": {
      "16": "assets/icon/icon-16.png",
      "32": "assets/icon/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.coto.com.ar/*"
      ],
      "js": [
        "dist/interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.coto.com.ar/*"
      ],
      "js": [
        "dist/badge.js"
      ],
      "css": [
        "src/theme.css",
        "src/badge.css",
        "src/skin.css",
        "src/skin-list.css",
        "src/skin-pdp.css",
        "src/theme-coto.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icon/icon.svg",
        "assets/banks/*",
        "assets/off/*",
        "assets/allergens/*"
      ],
      "matches": [
        "https://www.coto.com.ar/*"
      ]
    }
  ]
}
