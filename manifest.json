{
  "manifest_version": 3,
  "name": "Góndola para Coto: precio por kilo, promos y comparador",
  "short_name": "Góndola",
  "version": "0.12.0",
  "description": "Ordená Coto Digital por precio final por kilo o litro, con tu banco, el total real del carrito y el precio en Carrefour, Día y Más.",
  "icons": {
    "16": "assets/icon/icon-16.png",
    "32": "assets/icon/icon-32.png",
    "48": "assets/icon/icon-48.png",
    "128": "assets/icon/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.carrefour.com.ar/*",
    "https://diaonline.supermercadosdia.com.ar/*",
    "https://www.masonline.com.ar/*",
    "https://world.openfoodfacts.org/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_title": "Góndola",
    "default_icon": {
      "16": "assets/icon/icon-16.png",
      "32": "assets/icon/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.coto.com.ar/*"
      ],
      "js": [
        "dist/interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.coto.com.ar/*"
      ],
      "js": [
        "dist/badge.js"
      ],
      "css": [
        "src/badge.css",
        "src/skin.css",
        "src/skin-list.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/banks/*",
        "assets/off/*",
        "assets/allergens/*"
      ],
      "matches": [
        "https://www.coto.com.ar/*"
      ]
    }
  ]
}
