{
  "manifest_version": 3,
  "name": "Coto precio por unidad",
  "version": "0.5.0",
  "description": "Ordena Coto Digital por precio final por kg, litro o unidad, con tu banco y el total real del carrito.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Coto precio por unidad",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.coto.com.ar/*"],
      "js": ["dist/interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.coto.com.ar/*"],
      "js": ["dist/badge.js"],
      "css": ["src/badge.css"],
      "run_at": "document_start"
    }
  ]
}
